# PostgreSQL
POSTGRES_DB=sentinelflow
POSTGRES_USER=sentinelflow
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg://sentinelflow:change_me@localhost:5432/sentinelflow
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# AI Provider (Phase 2 Step 9) — mock needs no further configuration.
# ollama:             AI_PROVIDER=ollama, AI_MODEL=<local model name>
# cloud / OpenAI API: AI_PROVIDER=cloud, AI_BASE_URL=<endpoint>/v1, AI_API_KEY=<key>
AI_PROVIDER=mock
AI_MODEL=
AI_BASE_URL=http://localhost:11434
AI_API_KEY=
# Seconds to wait for one model call; local models can be slow (qwen3:4b ~40s)
AI_TIMEOUT_SECONDS=60

# Response Execution adapter (Phase 3.1.5 / 3.2.1) — mock is the offline
# DryRun executor and requires NO further configuration. shuffle / wazuh /
# thehive are RECOGNIZED architecture slots: startup validation is
# fail-closed on their credentials, and selecting one before its 3.2.3+
# implementation raises ConfigError (never a mock fallback).
# Single-Active-Adapter invariant: exactly ONE value — never "a,b".
EXECUTION_ADAPTER=mock

# External adapter credentials (Phase 3.2.1, frozen E3) — one flat
# *_BASE_URL / *_API_KEY pair per adapter. Each real adapter validates
# ONLY its own settings at startup; empty = fail-closed refusal.
# Placeholders only — real keys live in .env (gitignored), never here.
SHUFFLE_BASE_URL=
SHUFFLE_API_KEY=
WAZUH_BASE_URL=
WAZUH_API_KEY=
THEHIVE_BASE_URL=
THEHIVE_API_KEY=

# Execution WRITE-path shared secret (Phase 3.1.7) — required as
# "Authorization: Bearer <token>" on POST /api/v1/executions and
# POST /api/v1/executions/compensate. Leave empty and every write is
# rejected with 401 (fail-closed). Read-only GET endpoints need no token.
EXECUTION_TOKEN=
