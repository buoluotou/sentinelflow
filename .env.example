# PostgreSQL
POSTGRES_DB=sentinelflow
POSTGRES_USER=sentinelflow
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg://sentinelflow:change_me@localhost:5432/sentinelflow
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# AI Provider (Phase 2 Step 9) — mock needs no further configuration.
# ollama:             AI_PROVIDER=ollama, AI_MODEL=<local model name>
# cloud / OpenAI API: AI_PROVIDER=cloud, AI_BASE_URL=<endpoint>/v1, AI_API_KEY=<key>
AI_PROVIDER=mock
AI_MODEL=
AI_BASE_URL=http://localhost:11434
AI_API_KEY=
# Seconds to wait for one model call; local models can be slow (qwen3:4b ~40s)
AI_TIMEOUT_SECONDS=60

# Response Execution adapter (Phase 3.1.5 / 3.2.1) — mock is the offline
# DryRun executor and requires NO further configuration. shuffle / wazuh /
# thehive are RECOGNIZED architecture slots: startup validation is
# fail-closed on their credentials, and selecting one before its 3.2.3+
# implementation raises ConfigError (never a mock fallback).
# Single-Active-Adapter invariant: exactly ONE value — never "a,b".
EXECUTION_ADAPTER=mock

# External adapter credentials (Phase 3.2.1, frozen E3) — one flat
# *_BASE_URL / *_API_KEY pair per adapter (Wazuh uses an API user /
# password pair, 3.2.4). Each real adapter validates ONLY its own
# settings at startup; empty = fail-closed refusal. Placeholders only —
# real keys live in .env (gitignored), never here.
SHUFFLE_BASE_URL=
SHUFFLE_API_KEY=
WAZUH_BASE_URL=
WAZUH_API_USER=
WAZUH_API_PASSWORD=
THEHIVE_BASE_URL=
THEHIVE_API_KEY=

# Shuffle action -> workflow mapping (Phase 3.2.3, frozen design §4).
# Each executable action triggers EXACTLY ONE pre-configured workflow;
# selecting EXECUTION_ADAPTER=shuffle with any forward workflow id empty
# is a fail-closed ConfigError. Reverse workflows are OPTIONAL — when
# set, compensation of that action is supported.
SHUFFLE_WORKFLOW_BLOCK_SOURCE_IP=
SHUFFLE_WORKFLOW_ISOLATE_HOST=
SHUFFLE_WORKFLOW_DISABLE_ACCOUNT=
SHUFFLE_WORKFLOW_ESCALATE_TO_INCIDENT=
SHUFFLE_WORKFLOW_REVERSE_BLOCK_SOURCE_IP=
SHUFFLE_WORKFLOW_REVERSE_ISOLATE_HOST=
# Shuffle HTTP timeout in seconds (never above the sync dispatch budget).
SHUFFLE_TIMEOUT_SECONDS=30

# Wazuh adapter (Phase 3.2.4): Endpoint Response Provider only —
# agent actions (isolate host / disable account / block source ip).
# The action vocabulary is frozen inside the adapter; credentials
# above are all the configuration it needs. HTTP timeout follows the
# same budget rule.
WAZUH_TIMEOUT_SECONDS=30

# TheHive adapter (Phase 3.2.5): Case Management / Investigation
# provider only — escalate_to_incident creates a TheHive case, after
# which human investigators take over. No compensation exists: the
# case lifecycle belongs to the investigation. HTTP timeout follows
# the same budget rule.
THEHIVE_TIMEOUT_SECONDS=30

# Execution WRITE-path shared secret (Phase 3.1.7) — required as
# "Authorization: Bearer <token>" on POST /api/v1/executions and
# POST /api/v1/executions/compensate. Leave empty and every write is
# rejected with 401 (fail-closed). Read-only GET endpoints need no token.
EXECUTION_TOKEN=

# Operator registry (Phase 3.3.1, v1.3.0) — static JSON array of
# {name, token, role}, roles: viewer / reviewer / executor / admin.
# The Bearer token resolves to the SOLE recorded identity (a client-
# supplied "operator" field is always ignored); only executor / admin
# may dispatch (403 otherwise). Empty + empty EXECUTION_TOKEN = every
# write closed (401). Operator tokens never enter logs / responses /
# audit / DB. Placeholder shape only — real tokens live in .env.
OPERATORS_JSON=

# Execution Policy (Phase 3.3.2, v1.3.0) — read-only gate between
# Guard and Executor, DISABLED by default (exact v1.2.0 behavior).
# Time window is strict HH:MM, [start, end) UTC against the server
# clock; MIN_RISK_* are minimum SERVER-SIDE EventRisk.score per action
# (missing risk fact refuses fail-closed). Refusals land as
# guard_rejected with detail.source="policy"; a malformed policy
# configuration returns 503 and rolls back — never a silent allow.
EXECUTION_POLICY_ENABLED=false
EXECUTION_POLICY_WINDOW_START=09:00
EXECUTION_POLICY_WINDOW_END=18:00
EXECUTION_POLICY_MIN_RISK_BLOCK_SOURCE_IP=70
EXECUTION_POLICY_MIN_RISK_ISOLATE_HOST=70
EXECUTION_POLICY_MIN_RISK_DISABLE_ACCOUNT=80
EXECUTION_POLICY_MIN_RISK_ESCALATE_TO_INCIDENT=50
