# =============================================================================
# SentinelFlow — environment template
# =============================================================================
# Copy to .env and adjust:  cp .env.example .env   (Windows: Copy-Item)
# The quickstart script does this for you and FILLS IN a random local secret,
# so a first-time Demo install needs no hand-editing.
#
# RULES
#   * Secrets (any *_API_KEY / *_TOKEN / *_PASSWORD / DATABASE_URL) have NO real
#     default here. Values shown as empty or `change_me` are placeholders you
#     MUST replace. Never commit a populated .env — it is git-ignored.
#   * Every optional integration defaults to DISABLED / empty (fail-closed):
#     an unconfigured adapter is refused at startup, never half-run.
#   * Booleans are explicit `true` / `false`.
#
# THREE RUN MODES (see README "Run modes")
#   1. Demo Mode (DEFAULT)     AI_PROVIDER=mock, EXECUTION_ADAPTER=mock, all
#                              external sections left empty. No Wazuh / Shuffle /
#                              TheHive / Ollama needed.
#   2. AI Local Mode           Demo + AI_PROVIDER=ollama (+ AI_MODEL, AI_BASE_URL).
#                              Ollama is OPTIONAL; if it is unreachable only the
#                              AI endpoints degrade, the platform still runs.
#   3. Integration Lab Mode    LAB / EXPERIMENTAL / NOT PRODUCTION-CERTIFIED.
#                              Set EXECUTION_ADAPTER + the matching THEHIVE /
#                              WAZUH / SHUFFLE section for a lab YOU operate.
# =============================================================================


# --- CORE --------------------------------------------------------------------
# Application identity, the network bind address, and the ports the
# quickstart / compose publish.

# Display name reported by the API.
PROJECT_NAME=SentinelFlow

# HOST-SIDE address docker compose PUBLISHES ports on (postgres, backend,
# frontend, ollama). 127.0.0.1 (default) = loopback only, so a Demo on a
# laptop / office / lab LAN never exposes the stack to other hosts — the
# primary exposure control, since the platform ships without edge
# authentication (see SECURITY.md). Set 0.0.0.0 ONLY to deliberately allow
# remote access (advanced; put it behind your own SSO / reverse proxy first).
BIND_HOST=127.0.0.1

# Address a NATIVE / host-run backend binds to. Native uvicorn defaults to
# loopback, so 127.0.0.1 keeps a host-run backend local-only. (The Docker
# container binds 0.0.0.0 INTERNALLY via the compose command — not affected by
# this value; its host exposure is controlled by BIND_HOST above.)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Host port the frontend (nginx) is published on by docker compose.
FRONTEND_PORT=5173

# Frontend API base URL — the SINGLE authoritative source read by the web client
# (frontend/src/api/client.ts). Leave EMPTY for the default same-origin setup
# (dev: vite proxy; Docker: nginx reverse-proxies /api to the backend, so there
# is no CORS). Set an absolute origin (e.g. http://localhost:8000) ONLY if the
# frontend is served from a different host than the backend.
# NOTE: this is a frontend BUILD-TIME value. Vite reads it from frontend/.env
# (native dev) or the Docker build arg `--build-arg VITE_API_BASE_URL=...`; the
# backend ignores it. It is listed here as the one documented reference.
VITE_API_BASE_URL=

# Deduplication / aggregation window (seconds). Alerts with the same fingerprint
# inside this window collapse into one event and climb the frequency risk band.
DEDUP_WINDOW_SECONDS=300


# --- DATABASE ----------------------------------------------------------------

# Backend SQLAlchemy URL. Native dev may point at SQLite (sqlite:///local.db) or
# a local PostgreSQL. docker compose OVERRIDES this to the `postgres` service
# automatically, so leave the placeholder for container use.
# `change_me` is a LOCAL-DEV PLACEHOLDER, not a credential — replace it, or let
# quickstart generate a random one.
DATABASE_URL=postgresql+psycopg://sentinelflow:change_me@localhost:5432/sentinelflow

# Consumed by docker compose to create/serve the PostgreSQL container and to
# build the backend's in-network DATABASE_URL. POSTGRES_PASSWORD is REQUIRED
# (compose refuses to start with it empty); quickstart generates a random value.
POSTGRES_DB=sentinelflow
POSTGRES_USER=sentinelflow
POSTGRES_PASSWORD=
POSTGRES_PORT=5432


# --- AI ----------------------------------------------------------------------
# Analysis provider for alert explanation / risk summary / response
# recommendation. mock is deterministic, instant and offline (Demo default).

# mock | ollama  (mock = no network, no model download).
AI_PROVIDER=mock

# Model name for a real provider (e.g. qwen3:4b for Ollama). Ignored by mock.
AI_MODEL=

# Provider endpoint. For the Docker `ollama` profile use http://ollama:11434
# (service name); for a native/host Ollama use http://localhost:11434.
AI_BASE_URL=http://localhost:11434

# Provider API key — SECRET. Empty for mock and for a local Ollama.
AI_API_KEY=

# Per-request timeout (seconds). Local models can take tens of seconds.
AI_TIMEOUT_SECONDS=60

# Host port the optional Ollama container (docker compose --profile ollama) is
# published on. Only relevant to AI Local Mode.
OLLAMA_PORT=11434


# --- EXECUTION ---------------------------------------------------------------
# Response-execution adapter and the human-operator write-path credentials.

# mock | shuffle | wazuh | thehive.  mock = zero-outbound DryRun (Demo default);
# a real adapter refuses to boot until its section below is fully configured.
EXECUTION_ADAPTER=mock

# REAL-adapter compensation (Shuffle reverse workflows) is EXPERIMENTAL / NOT
# PRODUCTION-CERTIFIED — C-1: the reverse dispatch has no durable pre-dispatch
# reservation. Default false = a configured SHUFFLE_WORKFLOW_REVERSE_* id makes
# the backend REFUSE TO BOOT (fail-closed). Set true ONLY in a lab to acknowledge
# the risk. The mock Demo compensates safely (DryRun) and never needs this.
EXECUTION_COMPENSATION_EXPERIMENTAL=false

# Write-path shared secret (legacy single-operator fallback). Maps to a synthetic
# operator with the `executor` role. EMPTY = every write path returns 401
# (fail-closed). quickstart generates a random local token so the Demo can
# approve+execute. This value NEVER appears in logs, responses, audit rows or DB.
EXECUTION_TOKEN=

# Static operator registry: a JSON array of {"token","name","role"} objects.
# Roles: viewer | reviewer | executor | admin (only executor/admin may dispatch).
# When set, it is preferred over EXECUTION_TOKEN. Empty = use the legacy token
# above. Operator tokens never enter logs / responses / audit / DB.
# Example (DO NOT use these values): [{"token":"...","name":"ops-01","role":"executor"}]
OPERATORS_JSON=

# Execution policy (sits AFTER the guard, BEFORE the executor). Disabled keeps
# the base behavior; enabling NEVER bypasses auth / RBAC / approval / guard — a
# disabled policy is an ALLOW, not a bypass. A refusal is recorded as
# guard_rejected with detail.source=policy.
EXECUTION_POLICY_ENABLED=false
# Allowed window, strict HH:MM in UTC, [start, end).
EXECUTION_POLICY_WINDOW_START=09:00
EXECUTION_POLICY_WINDOW_END=18:00
# Minimum SERVER-SIDE risk score each action requires (missing risk = refuse).
EXECUTION_POLICY_MIN_RISK_BLOCK_SOURCE_IP=70
EXECUTION_POLICY_MIN_RISK_ISOLATE_HOST=70
EXECUTION_POLICY_MIN_RISK_DISABLE_ACCOUNT=80
EXECUTION_POLICY_MIN_RISK_ESCALATE_TO_INCIDENT=50


# --- THEHIVE  (Integration Lab — LAB / EXPERIMENTAL / NOT PRODUCTION) --------
# Case-management adapter. Leave everything empty for Demo Mode.
# A TheHive READER is authorized only by BOTH an independent read-only key AND
# an exact certified-version match; either missing/mismatched fails CLOSED.

THEHIVE_BASE_URL=
THEHIVE_API_KEY=
# Independent READ-ONLY key — must NEVER be the create-capable THEHIVE_API_KEY.
THEHIVE_READ_API_KEY=
# Must equal the reader's certified version (e.g. 4.1.24-1) or no reader is built.
THEHIVE_EXPECTED_VERSION=
THEHIVE_TIMEOUT_SECONDS=30
# INBOUND webhook trust domain (third, separate from the outbound key above and
# from human operators). Authenticates POST /api/v1/webhooks/thehive only.
THEHIVE_CALLBACK_TOKEN=


# --- WAZUH  (Integration Lab — LAB / EXPERIMENTAL / NOT PRODUCTION) -----------
# SIEM adapter (Basic auth user/password). Leave everything empty for Demo Mode.

WAZUH_BASE_URL=
WAZUH_API_USER=
WAZUH_API_PASSWORD=
WAZUH_TIMEOUT_SECONDS=30
# INBOUND webhook trust domain for POST /api/v1/webhooks/wazuh.
WAZUH_CALLBACK_TOKEN=


# --- SHUFFLE  (Integration Lab — LAB / EXPERIMENTAL / NOT PRODUCTION) ---------
# SOAR adapter. Leave everything empty for Demo Mode. Each executable action
# triggers EXACTLY ONE pre-configured workflow; an empty forward-workflow id
# keeps that action fail-closed. Reverse (compensation) workflows are OPTIONAL.

SHUFFLE_BASE_URL=
SHUFFLE_API_KEY=
SHUFFLE_TIMEOUT_SECONDS=30
# INBOUND webhook trust domain for POST /api/v1/webhooks/shuffle.
SHUFFLE_CALLBACK_TOKEN=
# Forward action -> workflow id mapping.
SHUFFLE_WORKFLOW_BLOCK_SOURCE_IP=
SHUFFLE_WORKFLOW_ISOLATE_HOST=
SHUFFLE_WORKFLOW_DISABLE_ACCOUNT=
SHUFFLE_WORKFLOW_ESCALATE_TO_INCIDENT=
# Optional reverse (compensation) workflows — LAB / EXPERIMENTAL ONLY.
# NOT PRODUCTION-CERTIFIED (C-1: no durable pre-dispatch reservation on the
# reverse path). Configuring an id ALSO requires EXECUTION_COMPENSATION_
# EXPERIMENTAL=true (above) or the backend REFUSES TO BOOT. Leave empty for
# Demo / production; the mock adapter compensates safely and needs no flag.
SHUFFLE_WORKFLOW_REVERSE_BLOCK_SOURCE_IP=
SHUFFLE_WORKFLOW_REVERSE_ISOLATE_HOST=


# --- OBSERVABILITY -----------------------------------------------------------

# Verbose logging + debug diagnostics. false (default) = INFO level, safe for
# quickstart/production; true = DEBUG level with exception stack traces. The
# backend log level is wired to this. Secrets are never logged at any level.
DEBUG=false

# Execution metrics (GET /api/v1/executions/metrics) and observed adapter health
# (GET /api/v1/executions/health) are always-on read-only endpoints derived from
# the append-only audit log — no configuration, no live external probe.
